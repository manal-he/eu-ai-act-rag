# Copy to .env and fill in only what you use. Never commit .env.
# Defaults run fully offline: fixture corpus, BM25 + hashing vectors, extractive mock LLM.

# --- corpus ---------------------------------------------------------------------------------
# After `make ingest`, point to the full FR/EN corpus:
# CORPUS_PATH=data/processed/corpus.jsonl

# --- retrieval ------------------------------------------------------------------------------
RETRIEVER=hybrid                 # bm25 | dense | hybrid
FUSION=rrf                       # rrf | weighted
CHUNKING=structure               # structure | fixed
CONTEXTUAL_HEADERS=template      # none | template | llm
RERANKER=none                    # none | local | cohere | vertex
EMBEDDING_PROVIDER=hashing       # hashing | local | vertex | openai
VECTOR_STORE=memory              # memory | pgvector
DATABASE_URL=
LANGUAGE_FILTER=auto             # auto (question language) | all

# --- generation -----------------------------------------------------------------------------
LLM_PROVIDER=mock                # mock | gemini | anthropic | openai
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-4o-mini

# --- Google Cloud (Vertex AI uses Application Default Credentials, no key) -------------------
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=europe-west1

# --- API keys (leave empty unless used) ------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
